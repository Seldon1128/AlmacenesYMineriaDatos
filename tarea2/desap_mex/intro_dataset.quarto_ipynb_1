    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fechas_anomalas = df[df['fecha_desap'].str.len() == 33274]['fecha_desap']\n",
        "val_anomalas = fechas_anomalas.unique()\n",
        "print(f\"Valores del campo fecha_desap con longitud 33,274: {val_anomalas}\")"
      ],
      "id": "8e39c8b5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Para obtener la fecha máxima y mínima que hay en nuestro conjunto de datos, vamos a dividir las filas que tienen más de una fecha y las que tienen solo una, para después pasar de tipo `str` a tipo `date`."
      ],
      "id": "a0a9606a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# filas con múltiples fechas\n",
        "fechas_anomalas = df[df['fecha_desap'].str.len() != 10]['fecha_desap']\n",
        "# eliminamos las fechas que se duplican\n",
        "fechas_anomalas = fechas_anomalas.drop_duplicates()\n",
        "\n",
        "# filas con solo una fecha\n",
        "fechas = df[df['fecha_desap'].str.len() == 10]['fecha_desap']\n",
        "# eliminamos duplicados\n",
        "fechas = fechas.drop_duplicates()\n",
        "dates = pd.to_datetime(fechas, errors='coerce', dayfirst=True)\n",
        "\n",
        "dates_anomalas = []\n",
        "\n",
        "for fechas in fechas_anomalas:\n",
        "    ls = str(fechas).split(', ')\n",
        "    dates_anomalas.extend(ls)\n",
        "\n",
        "dates_anomalas = pd.to_datetime(dates_anomalas, errors='coerce', dayfirst=True)\n",
        "\n",
        "min_global = dates_anomalas.min() if dates_anomalas.min() <= dates.min() else dates.min()\n",
        "max_global = dates_anomalas.max() if dates_anomalas.max() >= dates.max() else dates.max()\n",
        "\n",
        "print(f'Periodo cubierto: Del {min_global.date()} al {max_global.date()}')"
      ],
      "id": "1e22ad89",
      "execution_count": null,
      "outputs": []
    },
